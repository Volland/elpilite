# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Typed bitemporal neuro-symbolic database with ELPI as DDL and query language"
description:
  "elpilite stores typed λProlog facts in a Turso/SQLite file and answers ELPI queries over them, optimised for agentic memory."
maintainer: ["Volodymyr Pavlyshyn"]
authors: ["Volodymyr Pavlyshyn"]
license: "MIT"
homepage: "https://github.com/Volland/elpilite"
bug-reports: "https://github.com/Volland/elpilite/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.14"}
  "elpi" {= "1.18.2"}
  "yojson"
  "cmdliner"
  "digestif"
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Volland/elpilite.git"
